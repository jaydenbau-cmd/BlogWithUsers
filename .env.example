# Required: random string used for sessions and CSRF protection.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_KEY=replace-with-a-random-string

# Optional: leave DB_URI commented out to use a local SQLite database.
# DB_URI=postgresql://user:password@host/dbname

# Optional: only needed if you want the contact form to send real emails.
# If any of these are missing, messages are printed to the console instead.
# SMTP_ADDRESS=smtp.gmail.com
# EMAIL_ADDRESS=your-email@example.com
# EMAIL_PASSWORD=your-app-password
